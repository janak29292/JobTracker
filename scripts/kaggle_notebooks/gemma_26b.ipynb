# 2. Map Ollama's storage to Kaggle's persistent directory
os.environ["OLLAMA_MODELS"] = "/kaggle/working/ollama_models"
print("Set persistent storage path to /kaggle/working/ollama_models")

print("\n2. Starting Ollama Server...")
# env = dict(os.environ)
env = dict(os.environ, OLLAMA_MODELS="/kaggle/working/ollama_models")
env["OLLAMA_KEEP_ALIVE"] = "-1"
env["OLLAMA_HOST"] = "0.0.0.0"  # Prevents 403 Forbidden errors
env["OLLAMA_CONTEXT_LENGTH"] = "262144"
subprocess.Popen(["ollama", "serve"], env=env)
time.sleep(5)

print(f"\n3. Downloading {MODEL_NAME} (This will take 5-15 minutes)...")
subprocess.run(["ollama", "pull", MODEL_NAME])

