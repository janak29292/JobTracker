import subprocess
import time
import os
import urllib
import json
from kaggle_secrets import UserSecretsClient

user_secrets = UserSecretsClient()
NGROK_TOKEN = user_secrets.get_secret("NGROK_TOKEN")
NGROK_PASSWORD = user_secrets.get_secret("NGROK_PASSWORD")
NGROK_USER = user_secrets.get_secret("NGROK_USER")

MODEL_NAME = "gemma4:26b" # Or change to "gemma4:12b" for 10-second processing times

print("1. Installing Dependencies...")
